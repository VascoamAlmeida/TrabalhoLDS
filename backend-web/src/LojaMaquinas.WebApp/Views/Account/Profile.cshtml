@model LojaMaquinas.WebApp.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Perfil";
    ViewData["CurrentPage"] = "Perfil";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil - MachineHub</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .profile-avatar {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

        .avatar-circle {
            width: 120px;
            height: 120px;
            background-color: #e9ecef;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            position: relative;
        }

        .avatar-circle i {
            font-size: 50px;
            color: #6c757d;
        }

        .avatar-edit-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 36px;
            height: 36px;
            background-color: #0099cc;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 3px solid white;
        }

        .avatar-edit-btn i {
            font-size: 14px;
            color: white;
        }

        .form-section {
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #666;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            font-size: 14px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            background-color: #f8f9fa;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: #0099cc;
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(0, 153, 204, 0.1);
        }

        .form-control:disabled,
        .form-control[readonly] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }

        .btn-save {
            width: 100%;
            padding: 14px;
            background-color: #0099cc;
            color: white;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-save:hover {
            background-color: #007aa3;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 153, 204, 0.3);
        }

        .btn-save:active {
            transform: translateY(0);
        }

        .text-danger {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background-color: #d1e7dd;
            border: 1px solid #badbcc;
            color: #0f5132;
        }

        .validation-summary {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        @@media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="profile-container">
        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
        }

        <!-- Avatar -->
        <div class="profile-avatar">
            <div class="avatar-circle">
                <i class="fas fa-user"></i>
                <div class="avatar-edit-btn">
                    <i class="fas fa-camera"></i>
                </div>
            </div>
        </div>

        <!-- Informação da Conta (Read-Only) -->
        <div class="form-section">
            <h2 class="section-title">Informação da Conta</h2>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email"
                       class="form-control"
                       value="@Model.Email"
                       readonly
                       disabled />
            </div>
        </div>

        <!-- Profile Form -->
        <form method="post" asp-action="Profile" asp-controller="Account">
            @Html.AntiForgeryToken()

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="validation-summary">
                    <strong>Por favor corrija os seguintes erros:</strong>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <input type="hidden" asp-for="Client.Id" />
            <input type="hidden" asp-for="Client.UserId" />

            <!-- Dados Pessoais -->
            <div class="form-section">
                <h2 class="section-title">Dados Pessoais</h2>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Client.FirstName" class="form-label">Primeiro Nome</label>
                        <input asp-for="Client.FirstName"
                               class="form-control"
                               placeholder="Digite o seu primeiro nome" />
                        <span asp-validation-for="Client.FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Client.LastName" class="form-label">Último Nome</label>
                        <input asp-for="Client.LastName"
                               class="form-control"
                               placeholder="Digite o seu último nome" />
                        <span asp-validation-for="Client.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Client.Address" class="form-label">Morada</label>
                    <input asp-for="Client.Address"
                           class="form-control"
                           placeholder="Digite a sua morada completa" />
                    <span asp-validation-for="Client.Address" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Client.PostalCode" class="form-label">Código Postal</label>
                        <input asp-for="Client.PostalCode"
                               class="form-control"
                               placeholder="XXXX-XXX"
                               maxlength="8" />
                        <span asp-validation-for="Client.PostalCode" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Client.PhoneNumber" class="form-label">Telemóvel</label>
                        <input asp-for="Client.PhoneNumber"
                               class="form-control"
                               placeholder="9 dígitos"
                               maxlength="9" />
                        <span asp-validation-for="Client.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Client.NIF" class="form-label">NIF</label>
                    <input asp-for="Client.NIF"
                           class="form-control"
                           placeholder="9 dígitos"
                           maxlength="9" />
                    <span asp-validation-for="Client.NIF" class="text-danger"></span>
                </div>
            </div>

            <!-- Botão Guardar -->
            <button type="submit" class="btn-save">Guardar Alterações</button>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Traduzir mensagens de validação para português
        $.validator.methods.range = function (value, element, param) {
            var globalizedValue = value.replace(",", ".");
            return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
        };

        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        };

        if ($.validator) {
            $.extend($.validator.messages, {
                required: "Este campo é obrigatório.",
                remote: "Por favor, corrija este campo.",
                email: "Por favor, introduza um email válido.",
                url: "Por favor, introduza um URL válido.",
                date: "Por favor, introduza uma data válida.",
                dateISO: "Por favor, introduza uma data válida (ISO).",
                number: "Por favor, introduza um número válido.",
                digits: "Por favor, introduza apenas dígitos.",
                creditcard: "Por favor, introduza um número de cartão de crédito válido.",
                equalTo: "Por favor, introduza o mesmo valor novamente.",
                extension: "Por favor, introduza um ficheiro com uma extensão válida.",
                maxlength: $.validator.format("Por favor, não introduza mais de {0} caracteres."),
                minlength: $.validator.format("Por favor, introduza pelo menos {0} caracteres."),
                rangelength: $.validator.format("Por favor, introduza entre {0} e {1} caracteres."),
                range: $.validator.format("Por favor, introduza um valor entre {0} e {1}."),
                max: $.validator.format("Por favor, introduza um valor menor ou igual a {0}."),
                min: $.validator.format("Por favor, introduza um valor maior ou igual a {0}.")
            });
        }
    </script>
</body>
</html>
