@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - MachineHub</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
        }

        .login-title {
            font-size: 32px;
            font-weight: 700;
            color: #333;
            text-align: center;
            margin-bottom: 40px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            font-size: 14px;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
            background-color: #f8f8f8;
            transition: all 0.3s;
        }

        .form-control::placeholder {
            color: #999;
        }

        .form-control:focus {
            outline: none;
            border-color: #0099cc;
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(0, 153, 204, 0.1);
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background-color: #0099cc;
            color: white;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-login:hover {
            background-color: #007aa3;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 153, 204, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .text-danger {
            color: #dc3545;
            font-size: 13px;
            margin-top: 15px;
            display: block;
            text-align: center;
        }

        .register-link {
            text-align: center;
            margin-top: 20px;
            color: #666;
            font-size: 14px;
        }

        .register-link a {
            color: #0099cc;
            text-decoration: none;
            font-weight: 600;
        }

        .register-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h1 class="login-title">Login</h1>

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="text-danger mb-3">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                </div>
            }

            <div class="form-group">
                <input type="email"
                       class="form-control"
                       id="email"
                       name="email"
                       placeholder="Email"
                       required
                       autofocus />
            </div>

            <div class="form-group">
                <input type="password"
                       class="form-control"
                       id="password"
                       name="password"
                       placeholder="Palavra-passe"
                       required />
            </div>

            <button type="submit" class="btn-login">Entrar</button>

            <div class="register-link">
                Não tem conta? <a asp-action="Register" asp-controller="Account">Registe-se aqui</a>
            </div>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
