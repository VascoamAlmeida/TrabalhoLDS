@model LojaMaquinas.WebApp.ViewModels.MVC.ProductViewModel

@{
    ViewData["Title"] = "Detalhes do Produto";
    Layout = null;
}

<div class="col-md-12">
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold text-muted">TIPO</label>
            <p class="form-control-plaintext">
                @if (Model.Type == LojaMaquinas.Business.Models.Enums.ProductType.Machine)
                {
                    <span class="badge bg-primary fs-6">
                        <i class="fas fa-cogs me-1"></i>Máquina
                    </span>
                }
                else if (Model.Type == LojaMaquinas.Business.Models.Enums.ProductType.Part)
                {
                    <span class="badge bg-info fs-6">
                        <i class="fas fa-cog me-1"></i>Peça
                    </span>
                }
            </p>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold text-muted">ESTADO</label>
            <p class="form-control-plaintext">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success fs-6">
                        <i class="fas fa-check-circle me-1"></i>Ativo
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">
                        <i class="fas fa-times-circle me-1"></i>Inativo
                    </span>
                }
            </p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold text-muted">NOME</label>
            <p class="form-control-plaintext">
                <i class="fas fa-tag text-primary me-2"></i>@Model.Name
            </p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">MARCA</label>
            <p class="form-control-plaintext">
                <i class="fas fa-industry text-secondary me-2"></i>@Model.Brand
            </p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">MODELO</label>
            <p class="form-control-plaintext">
                <i class="fas fa-barcode text-secondary me-2"></i>@Model.Model
            </p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">ANO FABRICO</label>
            <p class="form-control-plaintext">
                <i class="fas fa-calendar-alt text-secondary me-2"></i>@Model.YearManufacture
            </p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">PREÇO</label>
            <p class="form-control-plaintext">
                <i class="fas fa-euro-sign text-success me-2"></i>@Model.Price.ToString("C2", new System.Globalization.CultureInfo("pt-PT"))
            </p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">QUANTIDADE</label>
            <p class="form-control-plaintext">
                <i class="fas fa-boxes text-info me-2"></i>@Model.Quantity unidades
            </p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">STOCK</label>
            <p class="form-control-plaintext">
                @if (Model.Stocks != null && Model.Stocks.Any())
                {
                    <span class="badge bg-success">
                        <i class="fas fa-check me-1"></i>@Model.Stocks.Count() items
                    </span>
                }
                else
                {
                    <span class="badge bg-warning">
                        <i class="fas fa-exclamation-triangle me-1"></i>Sem stock
                    </span>
                }
            </p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <label class="form-label fw-semibold text-muted">DESCRIÇÃO</label>
            <div class="border rounded-3 p-3 bg-light">
                <p class="mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Sem descrição</span>
                    }
                </p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Image))
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label fw-semibold text-muted">IMAGEM</label>
                <div class="text-center">
                    <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded-3" style="max-height: 200px;"
                         onerror="this.style.display='none'" />
                    <small class="text-muted d-block mt-2">@Model.Image</small>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .form-label.fw-semibold {
        font-weight: 600;
        margin-bottom: 5px;
        font-size: 0.85rem;
    }

    .form-control-plaintext {
        font-size: 1.05rem;
        padding: 8px 0;
    }

    .badge {
        padding: 8px 15px;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }
</style>