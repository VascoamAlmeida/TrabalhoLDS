<!-- _ModalCreate.cshtml -->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document" style="max-width: 900px;">
        <div class="modal-content shadow-lg border-0 rounded-3">

            <!-- Header -->
            <div class="modal-header bg-danger text-white rounded-top">
                <h5 class="modal-title fw-bold" id="createModalLabel">
                    <i class="fas fa-tools me-2"></i>Criar Produto
                </h5>
                <button type="button" class="close btn-close btn-close-white" data-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4" style="max-height: 80vh; overflow-y: auto;">
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light rounded-bottom d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary px-4" data-dismiss="modal">
                    <i class="fas fa-undo"></i>&nbsp;&nbsp;&nbsp;Voltar
                </button>
                <button type="submit" class="btn btn-danger px-4" id="CreateSaveButton">
                    <i class="fas fa-save"></i>&nbsp;&nbsp;&nbsp;Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .modal-content {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
    }

    .modal-footer button {
        min-width: 130px;
        font-weight: 600;
        border-radius: 8px;
        transition: background 0.3s;
    }

    .btn-danger:hover {
        background-color: #a10000;
    }

    .btn-outline-secondary:hover {
        background-color: #f1f1f1;
    }

    .form-label.fw-semibold {
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
        color: #333;
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 8px 12px;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
