@model LojaMaquinas.WebApp.ViewModels.MVC.OrderRent.CreateOrderRentViewModel

@{
	ViewData["Title"] = "Novo Aluguer";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color:#1e3a5f;">
                    <div>
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-handshake me-2"></i>Novo Aluguer
                        </h5>
                        <small class="text-white-50">
                            Máquina: @Model.MachineName
                        </small>
                    </div>
                </div>

                <form asp-action="Create"
                      asp-controller="OrderRent"
                      method="post"
                      class="p-4"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="MachineId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold text-muted">
                                <i class="fas fa-calendar-day text-primary me-1"></i>Data de Início
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold text-muted">
                                <i class="fas fa-calendar-check text-success me-1"></i>Data de Fim
                            </label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CompanyPhoto" class="form-label fw-semibold text-muted">
                            <i class="fas fa-camera text-info me-1"></i>Foto da máquina à saída
                        </label>
                        <input asp-for="CompanyPhoto" type="file" class="form-control" />
                        <span asp-validation-for="CompanyPhoto" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">
                            Utilizada como registo do estado do equipamento antes do aluguer.
                        </small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Voltar ao Catálogo
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            Continuar
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>


@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}

<style>
	.form-label.fw-semibold {
		font-weight: 600;
		margin-bottom: 6px;
		font-size: 0.9rem;
	}
</style>