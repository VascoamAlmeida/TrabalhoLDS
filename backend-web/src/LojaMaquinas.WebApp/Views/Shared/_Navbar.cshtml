@{
    var currentPage = ViewData["CurrentPage"] as string ?? "";
}

<nav class="main-navbar">
    <div class="navbar-container">
        <a href="/dashboard" class="nav-item @(currentPage == "Dashboard" ? "active" : "")">
            Dashboard
        </a>
        <a href="/stock" class="nav-item @(currentPage == "Stock" ? "active" : "")">
            Stock
        </a>
        <a href="/historico-compras" class="nav-item @(currentPage == "HistoricoCompras" ? "active" : "")">
            Histórico Compras
        </a>
        <a asp-controller="Maintenance" asp-action="Index" class="nav-item @(currentPage == "HistoricoManutencoes" ? "active" : "")">
            Histórico Manutenções
        </a>
        <a asp-controller="Account" asp-action="Profile" class="nav-item @(currentPage == "Perfil" ? "active" : "")">
            Perfil
        </a>
        <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline; margin-left: auto;">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-item logout-btn">
                Sair
            </button>
        </form>
    </div>
</nav>

<style>
    .main-navbar {
        background-color: white;
        border-bottom: 2px solid #e5e5e5;
        padding: 0;
        margin-bottom: 30px;
    }

    .navbar-container {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        padding: 0 20px;
    }

    .nav-item {
        padding: 18px 24px;
        color: #666;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        border-bottom: 3px solid transparent;
        transition: all 0.3s;
        display: inline-block;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
    }

    .nav-item:hover {
        color: #0099cc;
        background-color: #f8f8f8;
    }

    .nav-item.active {
        color: #0099cc;
        border-bottom-color: #0099cc;
    }

    .logout-btn {
        margin-left: auto;
        color: #dc3545;
    }

    .logout-btn:hover {
        color: #c82333;
        background-color: #fff5f5;
    }
</style>
