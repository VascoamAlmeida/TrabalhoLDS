@model OrderViewModel

@{
    Layout = null;
}

<div class="col-md-12">
    <form id="editOrderForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ClientId" />
        <input type="hidden" asp-for="StockId" />

        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-muted">
                    <i class="fas fa-calendar text-primary me-2"></i>DATA DO PEDIDO
                </label>
                <input type="date" class="form-control" asp-for="OrderDate" />
                <span asp-validation-for="OrderDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold text-muted">
                    <i class="fas fa-euro-sign text-success me-2"></i>TOTAL (€)
                </label>
                <input type="number" step="0.01" class="form-control" asp-for="Total" />
                <span asp-validation-for="Total" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-muted">
                    <i class="fas fa-tag text-info me-2"></i>TIPO DE PEDIDO
                </label>
                <select class="form-select" asp-for="Type">
                    <option value="1">Venda</option>
                    <option value="2">Aluguer</option>
                </select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold text-muted">
                    <i class="fas fa-info-circle text-warning me-2"></i>ESTADO DO PEDIDO
                </label>
                <select class="form-select" asp-for="Status">
                    <option value="1">Pendente</option>
                    <option value="2">Ativo</option>
                    <option value="3">Concluído</option>
                    <option value="4">Cancelado</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <div class="alert alert-info bg-light border-0 shadow-sm">
                    <h6 class="alert-heading mb-3">
                        <i class="fas fa-info-circle me-2"></i>Informações Não Editáveis
                    </h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold text-muted small mb-1">CLIENTE</label>
                            <p class="mb-0">
                                <i class="fas fa-user text-info me-2"></i>@(Model.Client != null ? Model.Client.FirstName + " " + (Model.Client.LastName ?? "") : "N/A")
                            </p>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold text-muted small mb-1">PRODUTO/MÁQUINA</label>
                            <p class="mb-0">
                                <i class="fas fa-cogs text-warning me-2"></i>@(Model.Stock != null && Model.Stock.Product != null ? Model.Stock.Product.Name : "N/A")
                            </p>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="fas fa-lock me-1"></i>Estes campos não podem ser alterados após a criação do pedido
                    </small>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .form-label.fw-semibold {
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 0.85rem;
        display: block;
    }

    .form-control,
    .form-select {
        padding: 10px 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #0099cc;
        box-shadow: 0 0 0 0.2rem rgba(0, 153, 204, 0.15);
    }

    .alert-info {
        border-left: 4px solid #0099cc;
    }

    .alert-heading {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1e3a5f;
    }
</style>
