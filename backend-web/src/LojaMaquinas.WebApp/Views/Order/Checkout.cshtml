@model OrderViewModel

@{
    ViewData["Title"] = "Finalizar Compra";
    ViewData["CurrentPage"] = "FinalizarCompra";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.0/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .checkout-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 40px;
    }

    .btn-back {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 20px;
        color: #333;
    }

    .btn-back:hover {
        background-color: #f8f9fa;
        border-color: #0099cc;
        color: #0099cc;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .section-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        border: 1px solid #f0f0f0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
    }

    .address-box {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border: 1px solid #e9ecef;
    }

    .address-icon {
        width: 48px;
        height: 48px;
        background: #e3f2fd;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0099cc;
        font-size: 20px;
        flex-shrink: 0;
    }

    .address-details h6 {
        font-size: 16px;
        font-weight: 600;
        color: #1a1a1a;
        margin: 0 0 6px 0;
    }

    .address-details p {
        font-size: 14px;
        color: #6c757d;
        margin: 0;
        line-height: 1.6;
    }

    .product-details {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .product-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border: 1px solid #e9ecef;
    }

    .product-image {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #0099cc, #007aa3);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 32px;
        flex-shrink: 0;
    }

    .product-info h6 {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 8px 0;
    }

    .product-category {
        font-size: 14px;
        color: #6c757d;
        margin: 0;
    }

    .product-specs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .spec-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px;
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .spec-label {
        font-size: 13px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .spec-value {
        font-size: 15px;
        font-weight: 600;
        color: #1a1a1a;
    }

    .product-description {
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border: 1px solid #e9ecef;
    }

    .product-description label {
        display: block;
        margin-bottom: 12px;
    }

    .product-description p {
        font-size: 14px;
        color: #495057;
        line-height: 1.6;
        margin: 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .summary-row:last-child {
        border-bottom: none;
        padding-top: 20px;
        margin-top: 10px;
        border-top: 2px solid #e9ecef;
    }

    .summary-label {
        font-size: 15px;
        color: #6c757d;
    }

    .summary-value {
        font-size: 15px;
        font-weight: 600;
        color: #1a1a1a;
    }

    .summary-row:last-child .summary-label {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .summary-row:last-child .summary-value {
        font-size: 24px;
        font-weight: 700;
        color: #0099cc;
    }

    .badge-free {
        background: #d4edda;
        color: #28a745;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-checkout {
        width: 100%;
        padding: 18px;
        background: #0099cc;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 30px;
    }

    .btn-checkout:hover {
        background: #007aa3;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 153, 204, 0.3);
    }

    .btn-checkout:active {
        transform: translateY(0);
    }
</style>

<div class="checkout-container">
    <!-- Header -->
    <div class="page-header">
        <button class="btn-back" onclick="window.history.back()">
            <i class="fas fa-arrow-left"></i>
        </button>
        <h1 class="page-title">Finalizar Compra</h1>
    </div>

    <form id="checkoutForm">
        <!-- Morada de Entrega -->
        <div class="section-card">
            <h3 class="section-title">Morada de Entrega</h3>
            <div class="address-box">
                <div class="address-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="address-details">
                    <h6>@(Model.Client != null ? Model.Client.FirstName + " " + (Model.Client.LastName ?? "") : "Cliente")</h6>
                    <p>@(Model.Client.Address), @(Model.Client.PostalCode)</p>
                </div>
            </div>
        </div>

        <!-- Detalhes do Produto -->
        <div class="section-card">
            <h3 class="section-title">Detalhes do Produto</h3>

            <div class="product-details">
                <div class="product-header">
                    <div class="product-image">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <div class="product-info">
                        <h6>@(Model.Stock?.Product?.Name ?? "Produto")</h6>
                        <p class="product-category">
                            <i class="fas fa-tag me-1"></i>
                            @(Model.Stock?.Product?.Category?.Name ?? "Categoria")
                        </p>
                    </div>
                </div>

                <div class="product-specs">
                    <div class="spec-item">
                        <span class="spec-label">
                            <i class="fas fa-barcode me-2"></i>Código
                        </span>
                        <span class="spec-value">@(Model.Stock?.Ref.ToString() ?? "N/A")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">
                            <i class="fas fa-industry me-2"></i>Marca
                        </span>
                        <span class="spec-value">@(Model.Stock?.Product?.Brand ?? "N/A")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">
                            <i class="fas fa-calendar-alt me-2"></i>Ano
                        </span>
                        <span class="spec-value">@(Model.Stock?.Product?.YearManufacture.ToString() ?? "N/A")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">
                            <i class="fas fa-euro me-2"></i>Preço
                        </span>
                        <span class="spec-value">@(Model.Stock?.Product?.Price.ToString("N2") ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumo do Pedido -->
        <div class="section-card">
            <h3 class="section-title">Resumo do Pedido</h3>

            @{
                var productPrice = Model.Stock?.Product?.Price ?? 0;
                var ivaAmount = productPrice * 0.23m;
                var totalAmount = productPrice * 1.23m;
            }

            <div class="summary-row">
                <span class="summary-label">Subtotal</span>
                <span class="summary-value">@productPrice.ToString("N2") €</span>
            </div>

            <div class="summary-row">
                <span class="summary-label">Envio</span>
                <span class="badge-free">Grátis</span>
            </div>

            <div class="summary-row">
                <span class="summary-label">IVA (23%)</span>
                <span class="summary-value">@ivaAmount.ToString("N2") €</span>
            </div>

            <div class="summary-row">
                <span class="summary-label">Total</span>
                <span class="summary-value">@totalAmount.ToString("N2") €</span>
            </div>
        </div>

        <!-- Botão Finalizar -->
        <button type="submit" class="btn-checkout">
            <i class="fas fa-check-circle me-2"></i>Finalizar Compra
        </button>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Submit do formulário
            $('#checkoutForm').on('submit', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Confirmar Compra?',
                    text: 'Deseja confirmar a finalização desta compra?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0099cc',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sim, confirmar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Ativar a order via AJAX
                        $.ajax({
                            url: '@Url.Content("~/order-active/")' + '@Model.Id',
                            type: 'PATCH',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Compra Finalizada!',
                                        text: response.message,
                                        showConfirmButton: false,
                                        timer: 2000
                                    }).then(() => {
                                        window.location.href = '@Url.Content("~/order-list")';
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Erro!',
                                        text: response.error || 'Erro ao finalizar a compra.'
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Erro!',
                                    text: 'Erro ao processar a compra.'
                                });
                            }
                        });
                    }
                });
            });
        });
    </script>
}
