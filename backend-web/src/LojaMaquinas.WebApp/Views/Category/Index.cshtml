@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Lista de Categorias";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.0/css/bootstrap.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.0/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" rel="stylesheet">

<h4>Fornecedor:</h4>
<hr />

<p>
    <a class="btn btn-danger btn-sm" data-toggle="modal" data-target="#createModal"><i class="fa fa-plus"></i> Adicionar</a>
</p>

<partial name="_CategoryList" />

<!-- Modal Area -->
<partial name="_ModalCreate" />
@*<partial name="_ModalEdit" />
<partial name="_ModalDetails" /> *@


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script> <!-- Nota: Modal precisa para excluir -->
    <!-- Bootstrap 5.1.0 JS -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>

    <!-- Bootstrap Datepicker JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>

    <!-- Toastr -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        #toast-container > .toast {
            white-space: nowrap; /* Evita quebra de linha */
            max-width: none; /* Remove o limite de largura padrão */
            width: auto; /* Ajusta automaticamente o tamanho horizontal */
            word-wrap: normal; /* Ajusta as palavras sem quebra */
        }
    </style>

    <script>
            toastr.options = {
            positionClass: 'toast-top-right', // Posição no canto superior direito
            preventDuplicates: true, // Evita mensagens duplicadas
            closeButton: true, // Botão para fechar manualmente
            progressBar: true, // Barra de progresso para o tempo de exibição
            timeOut: 5000, // Tempo para desaparecer (em milissegundos)
            extendedTimeOut: 3000, // Tempo adicional ao passar o mouse
            showDuration: 300, // Velocidade da animação ao exibir
            hideDuration: 300, // Velocidade da animação ao esconder
        }

        $(document).ready(function () {

            var baseUrl = '@Url.Content("~")';

            // Inicialize o DataTables na tabela
            $('#Table').DataTable({
                "paging": true,
                "pageLength": 10,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "language": {
                    "search": "Pesquisar:",
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Próximo"
                    },
                    "lengthMenu": "Mostrar _MENU_ registros por página",
                    "zeroRecords": "Nenhum registro encontrado",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    "infoEmpty": "Nenhum registro disponível",
                    "infoFiltered": "(filtrado de _MAX_ registros no total)"
                },
                "columnDefs": [
                    { "orderable": false, "targets": -1 } // Desabilita a ordenação para a última coluna
                ]
            });

            $('#createModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var modal = $(this);
                $.ajax({
                    url: baseUrl + '/category-create/',
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function () {

                        Swal.fire({
                            allowOutsideClick: false,
                            icon: "error",
                            text: "Erro ao carregar os dados."
                        });
                    }
                });

                $('#CreateSaveButton').off('click').on('click', function () {
                    var form = $('#CreateForm');

                    var formData = form.serialize();

                    $('.loaderContent').show();

                    $.ajax({
                        url: baseUrl + '/category-create/',
                        type: 'POST',
                        data: formData,
                        success: function (response) {

                            if (response.success) {

                                toastr.success(response.message);

                                setTimeout(function () { location.reload(); }, 3000);

                            } else {

                                if (Array.isArray(response.errors)) {
                                    response.errors.forEach(function (error) { toastr.error(error); });
                                } else if (typeof response.errors === 'string') {
                                    toastr.error(response.errors);
                                } else {
                                    toastr.error('Ocorreu um erro desconhecido! ');
                                }
                            }
                            $('.loaderContent').hide();

                        },
                        error: function () {

                            toastr.error('Ocorreu um erro ao processar sua solicitação! ');

                            setTimeout(function () { Swal.close(); }, 1000);

                        }
                    });

                }); // Fim #confirmCreateButton

            }); // Fim #createModal



            $('#editModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var modal = $(this);

                $.ajax({
                    url: baseUrl + '/category-edit/' + id,
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function () {

                        Swal.fire({
                            allowOutsideClick: false,
                            icon: "error",
                            text: "Erro ao carregar os dados."
                        });
                    }
                });

                $('#EditSaveButton').off('click').on('click', function () {
                    var form = $('#EditForm');
                    var formData = form.serialize();

                    $('.loaderContent').show();

                    $.ajax({
                        url: baseUrl + '/category-edit/' + id,
                        type: 'POST',
                        data: formData,
                        success: function (response) {

                            if (response.success) {

                                toastr.success(response.message);

                                setTimeout(function () { location.reload(); }, 3000);

                            } else {

                                if (Array.isArray(response.errors)) {
                                    response.errors.forEach(function (error) { toastr.error(error); });
                                } else if (typeof response.errors === 'string') {
                                    toastr.error(response.errors);
                                } else {
                                    toastr.error('Ocorreu um erro desconhecido! ');
                                }
                            }
                            $('.loaderContent').hide();

                        },
                        error: function () {

                            toastr.error('Ocorreu um erro ao processar sua solicitação! ');

                            setTimeout(function () { Swal.close(); }, 1000);

                        }
                    });

                }); // Fim #confirmEditButton

            }); // Fim #editModal

            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var modal = $(this);

                $.ajax({
                    url: baseUrl + '/category-details/' + id,
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function () {

                        Swal.fire({
                            allowOutsideClick: false,
                            icon: "error",
                            text: "Erro ao carregar os dados."
                        });
                    }
                });
            }); // Fim #detailsModal



            $(document).on('click', '.btn-outline-danger', function () {
                var button = $(this);
                var id = button.data('id');
                var name = button.data('name');

                Swal.fire({
                    title: 'Tem certeza que deseja excluir?',
                    text: `Fornecedor: ${name}`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não',
                    allowOutsideClick: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Aguarde...',
                            text: 'Processando sua solicitação de exclusão.',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: baseUrl + '/category-remove/' + id, // Endpoint de exclusão
                            type: 'POST',
                            data: {
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.success) {

                                    toastr.success(response.message);

                                    setTimeout(function () { location.reload(); }, 3000);

                                } else {

                                    if (Array.isArray(response.errors)) {
                                        response.errors.forEach(function (error) { toastr.error(error); });
                                    } else if (typeof response.errors === 'string') {
                                        toastr.error(response.errors);
                                    } else {
                                        toastr.error('Não foi possivel obter o erro do backend!');
                                    }
                                }
                                Swal.close(); // Fecha o modal de loading

                            },
                            error: function () {
                            Swal.close(); // Fecha o modal de loading
                            toastr.error('Ocorreu um erro ao submeter sua solicitação para URL! ');

                            setTimeout(function () { Swal.close(); }, 1000);

                            }
                        });
                    }
                });
            }); // Fim Remove (.btn-danger)




        }); // Fim document ready

    </script>

}
