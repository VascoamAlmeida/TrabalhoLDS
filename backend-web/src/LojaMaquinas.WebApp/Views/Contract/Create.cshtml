@model LojaMaquinas.WebApp.ViewModels.MVC.Contracts.ContractViewModel


@{
	ViewData["Title"] = "Contrato de aluguer";
}


<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-lg-10 col-xl-8">

			<div class="card shadow-sm border-0 contract-card">
				<div class="card-header text-white d-flex justify-content-between align-items-center contract-header">
					<div>
						<h5 class="mb-0 fw-bold">
							<i class="fas fa-file-signature me-2"></i>Contrato de Aluguer
						</h5>
						<small class="text-white-50">Revise os dados e aceite os termos para continuar.</small>
					</div>
					<div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center header-icon">
						<i class="fas fa-check"></i>
					</div>
				</div>

				<form asp-action="Create" asp-controller="Contract" method="post">
					<div class="card-body p-4">

						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
						<input type="hidden" asp-for="OrderRentId" />


						<h6 class="section-title">
							<i class="fas fa-clipboard-list me-2 text-primary"></i>Detalhes do Aluguer
						</h6>

						<div class="row g-3">
							<div class="col-md-8">
								<label asp-for="MachineName" class="form-label small text-muted"></label>
								<input asp-for="MachineName" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-4">
								<label asp-for="MachineModel" class="form-label small text-muted"></label>
								<input asp-for="MachineModel" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-6">
								<label asp-for="StartDate" class="form-label small text-muted"></label>
								<input asp-for="StartDate" type="date" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-6">
								<label asp-for="EndDate" class="form-label small text-muted"></label>
								<input asp-for="EndDate" type="date" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-4">
								<label asp-for="Duration" class="form-label small text-muted"></label>
								<div class="input-group input-group-sm">
									<input asp-for="Duration" class="form-control bg-light" readonly />
									<span class="input-group-text bg-light border-start-0">dias</span>
								</div>
							</div>

							<div class="col-md-4">
								<label asp-for="DailyPrice" class="form-label small text-muted"></label>
								<input asp-for="DailyPrice"
									   class="form-control form-control-sm bg-light"
									   data-val="false" readonly />
							</div>

							<div class="col-md-4">
								<label asp-for="Total" class="form-label small text-muted"></label>
								<input asp-for="Total"
									   class="form-control form-control-sm bg-light fw-semibold text-success"
									   data-val="false" readonly />
							</div>
						</div>

						<hr class="my-4" />


						<h6 class="section-title">
							<i class="fas fa-file-contract me-2 text-primary"></i>Termos e Condições
						</h6>

						<div class="mb-3">
							<div class="terms-box border rounded-3 bg-light p-3">
								<textarea asp-for="TermsConditions"
										  class="form-control border-0 bg-transparent small"
										  rows="6"
										  readonly></textarea>
							</div>
							<span asp-validation-for="TermsConditions" class="text-danger"></span>
						</div>

						<div class="form-check mb-4">
							<input asp-for="AcceptTerms" class="form-check-input" />
							<label asp-for="AcceptTerms" class="form-check-label small"></label>
							<span asp-validation-for="AcceptTerms" class="text-danger d-block"></span>
						</div>


						<h6 class="section-title">
							<i class="fas fa-user me-2 text-primary"></i>Dados do Cliente
						</h6>

						<div class="row g-3">
							<div class="col-md-6">
								<label asp-for="ClientName" class="form-label small text-muted"></label>
								<input asp-for="ClientName" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-6">
								<label asp-for="ClientEmail" class="form-label small text-muted"></label>
								<input asp-for="ClientEmail" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-6">
								<label asp-for="ClientPhone" class="form-label small text-muted"></label>
								<input asp-for="ClientPhone" class="form-control form-control-sm bg-light" readonly />
							</div>

							<div class="col-md-6">
								<label asp-for="ClientAddress" class="form-label small text-muted"></label>
								<input asp-for="ClientAddress" class="form-control form-control-sm bg-light" readonly />
							</div>
						</div>
					</div>

					<div class="card-footer bg-light border-0 p-3 d-flex justify-content-between align-items-center">
						<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
							Voltar ao Catálogo
						</a>
						<button type="submit" class="btn btn-primary px-4">
							Efetuar Pagamento
						</button>
					</div>
				</form>
			</div>

		</div>
	</div>
</div>


@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}


<style>
	.contract-card {
		border-radius: 16px;
		overflow: hidden;
	}

	.contract-header {
		background: linear-gradient(90deg, #1e3a5f, #2563eb);
		padding: 16px 24px;
	}

	.header-icon {
		width: 40px;
		height: 40px;
		font-size: 18px;
	}

	.section-title {
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: .05em;
		margin-bottom: 0.75rem;
		color: #4b5563;
	}

	.terms-box {
		max-height: 220px;
		overflow-y: auto;
	}
</style>
